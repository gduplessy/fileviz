<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- FileViz additions to the Fluent theme. Theme-dependent colors come from Fluent keys (see docs/design.md, Tokens). -->
 <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
 <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
 <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
 <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

 <!-- File-type palette: theme-independent fills and their label colors. -->
 <SolidColorBrush x:Key="CategoryDiskBrush" Color="#46546D"/>
 <SolidColorBrush x:Key="CategoryVideoBrush" Color="#2F5DA8"/>
 <SolidColorBrush x:Key="CategoryCodeBrush" Color="#B04D66"/>
 <SolidColorBrush x:Key="CategoryImageBrush" Color="#23877B"/>
 <SolidColorBrush x:Key="CategoryAudioBrush" Color="#7656A6"/>
 <SolidColorBrush x:Key="CategoryDocumentBrush" Color="#5E8F33"/>
 <SolidColorBrush x:Key="CategoryArchiveBrush" Color="#D68B2A"/>
 <SolidColorBrush x:Key="CategoryCacheBrush" Color="#A3ABB5"/>
 <SolidColorBrush x:Key="CategoryOtherBrush" Color="#CBD0D7"/>

 <!-- Age ramp: older is darker. -->
 <SolidColorBrush x:Key="Age0Brush" Color="#EDE6D8"/>
 <SolidColorBrush x:Key="Age1Brush" Color="#DCC7A0"/>
 <SolidColorBrush x:Key="Age2Brush" Color="#C49A55"/>
 <SolidColorBrush x:Key="Age3Brush" Color="#9C6A22"/>
 <SolidColorBrush x:Key="Age4Brush" Color="#6B4210"/>

 <SolidColorBrush x:Key="TileLightLabelBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="TileDarkLabelBrush" Color="#1A1C1F"/>

 <!-- Brand mark colors. Not used as UI color. -->
 <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0F6A87"/>
 <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#23877B"/>
 <SolidColorBrush x:Key="BrandTertiaryBrush" Color="#D68B2A"/>

 <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
 <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
 <Thickness x:Key="PagePadding">24,20,24,16</Thickness>
</ResourceDictionary>
