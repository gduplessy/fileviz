<Window x:Class="FileViz.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FileViz.App.Views"
 Title="FileViz" Width="1400" Height="900" MinWidth="1050" MinHeight="700" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
 <Window.InputBindings><KeyBinding Key="F5" Command="{Binding ScanCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/><KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}"/><KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}"/></Window.InputBindings>
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid ClipToBounds="True">
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="7"><TextBlock Text="▾" HorizontalAlignment="Right" Foreground="{DynamicResource Ink}"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="8,7,24,7" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="RowBackground" Value="{DynamicResource Card}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="RowHeight" Value="30"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,2" Padding="10,8"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#268A9B"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#268A9B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="FileViz" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="See where your space goes." Opacity="0.65" FontSize="14"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Theme" Click="Theme_Click" AutomationProperties.Name="Switch color theme"/><Button Content="Run as administrator" Command="{Binding ElevateCommand}"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding SummaryText}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding CoverageText}" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Scan selected roots" Command="{Binding ScanCommand}"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanInteract}">
    <TextBlock Text="DRIVES AND ROOTS" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
    <ItemsControl ItemsSource="{Binding Drives}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Add folder or share" Command="{Binding AddRootCommand}" Margin="0,10,0,12"/>
    <CheckBox Content="Administrator scan" IsChecked="{Binding Administrator}"/><CheckBox Content="Prefer raw MFT" IsChecked="{Binding PreferMft}"/>
    <Expander Header="Additional roots and scan settings" Margin="0,10,0,0"><StackPanel>
     <TextBlock Text="Extra roots (one per line)"/><TextBox Text="{Binding ExtraRoots}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extra scan roots"/>
     <TextBlock Text="Exclusions (one per line)"/><TextBox Text="{Binding Exclusions}" AcceptsReturn="True" Height="60" AutomationProperties.Name="Scan exclusions"/>
     <TextBlock Text="Scan profile"/><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}"/><TextBox Text="{Binding ProfileName}" AutomationProperties.Name="Profile name"/><Button Content="Save profile" Command="{Binding SaveProfileCommand}"/>
    </StackPanel></Expander>
    <TextBlock Text="Snapshot" Margin="0,18,0,0"/><ComboBox ItemsSource="{Binding History}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSnapshot}" AutomationProperties.Name="Selected snapshot"/>
    <TextBlock Text="Drive / root in snapshot"/><ComboBox ItemsSource="{Binding SnapshotRoots}" SelectedItem="{Binding CurrentRoot}"/>
    <Button Content="Export CSV / JSON" Command="{Binding ExportCommand}"/>
   </StackPanel></ScrollViewer>
   <TabControl Grid.Column="2" x:Name="Tabs">
    <TabItem Header="Space explorer"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel>
      <StackPanel><TextBlock Text="Name or path"/><TextBox Width="180" Text="{Binding Search}" AutomationProperties.Name="Search name or path"/></StackPanel>
      <StackPanel Margin="8,0,0,0"><TextBlock Text="Extension"/><TextBox Width="65" Text="{Binding Extension}" ToolTip="For example .mkv" AutomationProperties.Name="Extension filter"/></StackPanel>
      <StackPanel Margin="8,0,0,0"><TextBlock Text="Min. MiB"/><TextBox Width="70" Text="{Binding MinimumMiB}" AutomationProperties.Name="Minimum size in MiB"/></StackPanel>
      <StackPanel Margin="8,0,0,0"><TextBlock Text="Modified since"/><DatePicker Width="125" SelectedDate="{Binding ModifiedAfter}" AutomationProperties.Name="Modified on or after" Margin="0,4,0,10"/></StackPanel>
      <CheckBox Content="Allocated size" IsChecked="{Binding Allocated}" Margin="12,24,0,0"/><CheckBox Content="Hidden only" IsChecked="{Binding HiddenOnly}" Margin="12,24,0,0"/>
      <Button Content="Filter" Command="{Binding FilterCommand}" VerticalAlignment="Top" Margin="12,18,0,10"/>
     </WrapPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Largest files" Command="{Binding LargestCommand}"/><Button Content="Up" Command="{Binding UpCommand}"/><TextBlock Text="{Binding BrowseLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
     <local:Treemap Grid.Row="2" Items="{Binding MapItems}" FolderChosen="Treemap_FolderChosen" Margin="0,0,0,12"/>
     <DataGrid Grid.Row="3" x:Name="FilesGrid" ItemsSource="{Binding Files}" MouseDoubleClick="Files_DoubleClick" AutomationProperties.Name="Files in selected drive">
      <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/><DataGridCheckBoxColumn Header="Folder" Binding="{Binding IsDirectory}" Width="55"/><DataGridTextColumn Header="Logical" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedText}" Width="90"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="140"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/></DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Explorer" Click="Explorer_Click"/><Button Content="Copy path" Click="Copy_Click"/><Button Content="Properties" Click="Properties_Click"/><Button Content="Review cleanup" Click="CleanupFiles_Click"/></WrapPanel>
    </Grid></TabItem>
    <TabItem Header="Folders"><DataGrid ItemsSource="{Binding Folders}" Margin="14" MouseDoubleClick="Folders_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Folder" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes,StringFormat=N0}" Width="140"/><DataGridTextColumn Header="Files" Binding="{Binding Count,StringFormat=N0}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="File types"><DataGrid ItemsSource="{Binding ExtensionsBreakdown}" Margin="14"><DataGrid.Columns><DataGridTextColumn Header="Extension" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Logical bytes" Binding="{Binding Bytes,StringFormat=N0}" Width="160"/><DataGridTextColumn Header="Files" Binding="{Binding Count,StringFormat=N0}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Duplicates"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><ComboBox Width="110" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}"/><CheckBox Content="Use selected roots below" IsChecked="{Binding CrossDrive}" Margin="12,8,0,0"/><Button Content="Find duplicates" Command="{Binding DuplicateCommand}" Margin="12,4,0,0" VerticalAlignment="Top"/></StackPanel>
     <StackPanel Grid.Row="1"><ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding DuplicateRoots}" IsEnabled="{Binding CrossDrive}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Root}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Orientation="Horizontal"><TextBlock Text="Preferred keeper folder" VerticalAlignment="Center"/><TextBox Width="260" Text="{Binding PreferredFolder}" Margin="12,0,0,10"/></StackPanel><TextBlock Text="{Binding DuplicateText}" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
     <DataGrid Grid.Row="2" x:Name="DuplicatesGrid" ItemsSource="{Binding Duplicates}"><DataGrid.Columns><DataGridTextColumn Header="Group" Binding="{Binding GroupId}" Width="65"/><DataGridCheckBoxColumn Header="Suggested keeper" Binding="{Binding SuggestedKeeper}" Width="125"/><DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding Entry.SizeText}" Width="90"/><DataGridTextColumn Header="Path" Binding="{Binding Entry.Path}" Width="*"/></DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Previous groups" Command="{Binding DuplicatePreviousCommand}"/><Button Content="Next groups" Command="{Binding DuplicateNextCommand}"/><Button Content="Review selected removals" Click="CleanupDuplicates_Click"/></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Compare"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Compare current snapshot against" VerticalAlignment="Center"/><ComboBox Width="330" ItemsSource="{Binding History}" DisplayMemberPath="Label" SelectedItem="{Binding CompareBefore}" Margin="12,0,0,10"/><Button Content="Compare" Command="{Binding CompareCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Differences}"><DataGrid.Columns><DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="100"/><DataGridTextColumn Header="Before bytes" Binding="{Binding Before,StringFormat=N0}" Width="120"/><DataGridTextColumn Header="After bytes" Binding="{Binding After,StringFormat=N0}" Width="120"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="Cleanup history"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="Restore selected" Click="Restore_Click"/><Button Content="Send selected to Recycle Bin" Click="Recycle_Click"/><TextBlock Text="Quarantine retains disk space." VerticalAlignment="Center"/></StackPanel><DataGrid Grid.Row="1" x:Name="CleanupGrid" ItemsSource="{Binding CleanupHistory}"><DataGrid.Columns><DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Original path" Binding="{Binding Original}" Width="*"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="230"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="Diagnostics"><DataGrid ItemsSource="{Binding Errors}" Margin="14"><DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
 </Grid>
</Window>