<Window x:Class="FileViz.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:FileViz.App.ViewModels" xmlns:sections="clr-namespace:FileViz.App.Views.Sections"
 Title="FileViz" Width="1400" Height="900" MinWidth="1050" MinHeight="700" FontFamily="{StaticResource TextFont}">
 <WindowChrome.WindowChrome>
  <!-- Content extends into the title bar over the Mica backdrop; Windows keeps drawing the caption buttons, so Snap Layouts work. -->
  <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
 </WindowChrome.WindowChrome>
 <Window.InputBindings>
  <KeyBinding Key="F5" Command="{Binding Home.ScanCommand}"/>
  <KeyBinding Key="Escape" Command="{Binding Session.CancelCommand}"/>
  <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Explorer.UpCommand}"/>
  <KeyBinding Key="E" Modifiers="Control" Command="{Binding Explorer.ExportCommand}"/>
  <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
  <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="0"/>
  <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="1"/>
  <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="2"/>
  <KeyBinding Key="D4" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="3"/>
  <KeyBinding Key="D5" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="4"/>
  <KeyBinding Key="D6" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="5"/>
  <KeyBinding Key="D7" Modifiers="Control" Command="{Binding GoCommand}" CommandParameter="6"/>
 </Window.InputBindings>
 <Window.CommandBindings>
  <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed"/>
 </Window.CommandBindings>
 <Window.Resources>
  <DataTemplate DataType="{x:Type vm:HomeViewModel}"><sections:HomeView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ExplorerViewModel}"><sections:ExplorerView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><sections:DuplicatesView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:PhotosViewModel}"><sections:PhotosView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:CompareViewModel}"><sections:CompareView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><sections:CleanupView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><sections:DiagnosticsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><sections:SettingsView/></DataTemplate>
  <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
   <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Shortcut}" ToolTipService.ShowOnDisabled="False">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0"/>
     <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource CaptionText}" FontWeight="Normal" VerticalAlignment="Center"/>
    </Grid>
   </RadioButton>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>

  <!-- Title bar -->
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
    <Canvas Width="16" Height="16" Margin="0,0,12,0" AutomationProperties.Name="FileViz">
     <Rectangle Canvas.Left="1" Canvas.Top="1" Width="8" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource BrandPrimaryBrush}"/>
     <Rectangle Canvas.Left="10" Canvas.Top="1" Width="5" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource BrandSecondaryBrush}"/>
     <Rectangle Canvas.Left="10" Canvas.Top="10" Width="5" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource BrandTertiaryBrush}"/>
    </Canvas>
    <TextBlock Text="FileViz" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" CornerRadius="4" Padding="6,0"><TextBlock Text="Preview" Style="{StaticResource TagText}"/></Border>
   </StackPanel>
   <Grid Grid.Column="1" Width="440" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,64,6" AutomationProperties.Name="Search this snapshot" IsEnabled="{Binding Session.HasSnapshot}">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
    </TextBox>
    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <TextBlock x:Name="SearchHint" Text="Search this snapshot" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
     <TextBlock.Style>
      <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Margin="0,0,10,0" CornerRadius="3" Padding="5,0" IsHitTestVisible="False"><TextBlock Text="Ctrl+F" Style="{StaticResource TagText}"/></Border>
   </Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0" ToolTip="Scans run unelevated unless you choose an administrator scan.">
    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="{Binding Session.ElevationText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>

   <!-- Navigation -->
   <DockPanel x:Name="NavPane" Margin="8,4,8,8">
    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsNav}" ContentTemplate="{StaticResource NavTemplate}" Focusable="False"/>
    <ItemsControl ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavTemplate}" Focusable="False" AutomationProperties.Name="Sections"/>
   </DockPanel>

   <!-- Content layer -->
   <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ContentControl x:Name="ContentHost" Content="{Binding SelectedNav.Content}" Focusable="False"/>
     <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="{Binding Session.SnapshotText}" Style="{StaticResource CaptionText}" Margin="16,0,0,0"/>
        <TextBlock Text="Data stays on this PC" Style="{StaticResource CaptionText}" Margin="16,0,0,0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
         <Ellipse.Style>
          <Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
           <Style.Triggers><DataTrigger Binding="{Binding Session.Busy}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/></DataTrigger></Style.Triggers>
          </Style>
         </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Session.Status}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </DockPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
