<UserControl x:Class="FileViz.App.Views.Sections.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <ComboBox Width="320" ItemsSource="{Binding Session.History}" DisplayMemberPath="Label" SelectedItem="{Binding Session.SelectedSnapshot}" IsEnabled="{Binding Session.CanInteract}" AutomationProperties.Name="Selected snapshot" Margin="0,0,8,0"/>
    <Button Click="CopyReport_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Copy report"/></StackPanel></Button>
   </StackPanel>
   <TextBlock Text="Diagnostics" Style="{StaticResource TitleText}"/>
  </DockPanel>

  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,14">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Style="{StaticResource Badge}" BorderThickness="0" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Padding="12,4" Margin="0,0,8,0" Visibility="{Binding GapCount, Converter={StaticResource VisibleIfPositive}}"><TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"><Run Text="{Binding GapCount, Mode=OneWay}"/><Run Text=" coverage gaps"/></TextBlock></Border>
     <Border Style="{StaticResource Badge}" BorderThickness="0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="12,4" Margin="0,0,8,0" Visibility="{Binding WarningCount, Converter={StaticResource VisibleIfPositive}}"><TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource SystemFillColorCautionBrush}"><Run Text="{Binding WarningCount, Mode=OneWay}"/><Run Text=" warnings"/></TextBlock></Border>
     <Border Style="{StaticResource Badge}" Padding="12,4" Visibility="{Binding InfoCount, Converter={StaticResource VisibleIfPositive}}"><TextBlock Style="{StaticResource BadgeText}"><Run Text="{Binding InfoCount, Mode=OneWay}"/><Run Text=" not traversed"/></TextBlock></Border>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="{Binding Headline}" Style="{StaticResource BodyStrongText}" FontSize="16" Typography.NumeralAlignment="Tabular"/>
     <TextBlock Text="{Binding SummaryText}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,0"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Padding="12,8">
      <Border Style="{StaticResource SegmentTrack}">
       <StackPanel Orientation="Horizontal">
        <RadioButton Style="{StaticResource Segment}" GroupName="DiagnosticFilter" Content="{Binding AllLabel}" IsChecked="{Binding ShowAll}"/>
        <RadioButton Style="{StaticResource Segment}" GroupName="DiagnosticFilter" Content="{Binding GapLabel}" IsChecked="{Binding ShowGaps}"/>
        <RadioButton Style="{StaticResource Segment}" GroupName="DiagnosticFilter" Content="{Binding WarningLabel}" IsChecked="{Binding ShowWarnings}"/>
        <RadioButton Style="{StaticResource Segment}" GroupName="DiagnosticFilter" Content="{Binding InfoLabel}" IsChecked="{Binding ShowInfo}"/>
       </StackPanel>
      </Border>
     </Border>
     <Grid>
      <TextBlock Text="Nothing to report for this snapshot." Style="{StaticResource CaptionText}" Margin="16" Visibility="{Binding NoRows, Converter={StaticResource Visible}}"/>
      <DataGrid x:Name="RowsGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Rows}" SelectionMode="Single" AutomationProperties.Name="Diagnostics" Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="36">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE946;" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" AutomationProperties.Name="{Binding SeverityName}"/>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding SeverityName}" Value="Gap"><Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
           <DataTrigger Binding="{Binding SeverityName}" Value="Warning"><Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Kind" Binding="{Binding Label}" Width="130"/>
        <DataGridTemplateColumn Header="Path" Width="*">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Message" Width="*">
         <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="76">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal">
           <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="14" Content="&#xE838;" Click="Open_Click" AutomationProperties.Name="Show in File Explorer"/>
           <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="14" Content="&#xE8C8;" Click="Copy_Click" AutomationProperties.Name="Copy path"/>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,14">
      <StackPanel Orientation="Horizontal">
       <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
       <TextBlock Text="For access errors, check permissions for your Windows account, then rescan. An administrator scan reads more local folders; network shares always use your existing credentials." Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="270"/>
      </StackPanel>
     </Border>
     <StackPanel Margin="18,16">
      <TextBlock Text="What this affects" Style="{StaticResource BodyStrongText}" FontSize="16" Margin="0,0,0,10"/>
      <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"><Run Text="Totals" FontWeight="SemiBold"/><Run Text=" leave out folders that could not be read."/></TextBlock>
      <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"><Run Text="Compare" FontWeight="SemiBold"/><Run Text=" may list files in missing folders as added or removed."/></TextBlock>
      <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"><Run Text="Duplicates" FontWeight="SemiBold"/><Run Text=" skips files it never saw."/></TextBlock>
      <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="-18,10"/>
      <TextBlock Text="Engines" Style="{StaticResource BodyStrongText}" Margin="0,0,0,6"/>
      <TextBlock Text="Raw MFT reading applies only to whole local NTFS volumes with an administrator scan. Folders, shares, and other file systems use directory enumeration. A raw failure discards its results and falls back, recorded here as Engine fallback." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
     </StackPanel>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
