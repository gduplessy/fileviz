<UserControl x:Class="FileViz.App.Views.Sections.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="DriveCard">
   <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,12">
    <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Label}" HorizontalContentAlignment="Stretch">
     <StackPanel Margin="4,0,0,0">
      <DockPanel>
       <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Tag="{Binding LastState}"><TextBlock Style="{StaticResource StateBadgeText}"/></Border>
       <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
      <ProgressBar Style="{StaticResource CapacityBar}" Value="{Binding UsedPercent, Mode=OneWay}" Tag="{Binding NearlyFull}" Margin="0,8,0,6" Visibility="{Binding HasCapacity, Converter={StaticResource Visible}}" AutomationProperties.Name="Used space"/>
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Text="{Binding Engine}" Style="{StaticResource CaptionText}"/>
       <TextBlock Text="{Binding UsageText}" Style="{StaticResource CaptionText}" Typography.NumeralAlignment="Tabular"/>
      </DockPanel>
     </StackPanel>
    </CheckBox>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>

  <!-- First run: no snapshot yet -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsFirstRun, Converter={StaticResource Visible}}">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="980" Margin="32">
    <Canvas Width="56" Height="56" HorizontalAlignment="Center" AutomationProperties.Name="FileViz">
     <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="28" Height="49" RadiusX="5" RadiusY="5" Fill="{StaticResource BrandPrimaryBrush}"/>
     <Rectangle Canvas.Left="35" Canvas.Top="3.5" Width="17.5" Height="28" RadiusX="5" RadiusY="5" Fill="{StaticResource BrandSecondaryBrush}"/>
     <Rectangle Canvas.Left="35" Canvas.Top="35" Width="17.5" Height="17.5" RadiusX="5" RadiusY="5" Fill="{StaticResource BrandTertiaryBrush}"/>
    </Canvas>
    <TextBlock Text="See where your space goes" Style="{StaticResource TitleText}" FontSize="36" LineHeight="44" HorizontalAlignment="Center" Margin="0,12,0,8"/>
    <TextBlock Text="Pick a drive or folder to scan. FileViz reads file metadata only, changes nothing, and keeps every result on this PC." Style="{StaticResource BodyText}" FontSize="15" TextAlignment="Center" MaxWidth="560" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,28"/>
    <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource DriveCard}" Focusable="False" AutomationProperties.Name="Drives">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
    <Button Command="{Binding AddRootCommand}" HorizontalAlignment="Left">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="Folder or share"/></StackPanel>
    </Button>
    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0">
     <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Session.Administrator}" HorizontalAlignment="Center">
      <StackPanel><TextBlock Text="Administrator scan"/><TextBlock Text="Faster raw MFT reading on NTFS. Windows will ask for permission." Style="{StaticResource CaptionText}"/></StackPanel>
     </CheckBox>
     <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanCommand}" Content="{Binding ScanButtonText}" MinHeight="44" MinWidth="240" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,0" ToolTip="F5"/>
    </StackPanel>
    <UniformGrid Columns="3" Margin="0,36,0,0">
     <StackPanel Margin="0,0,24,0"><TextBlock Text="1  Scan" Style="{StaticResource BodyStrongText}"/><TextBlock Text="Metadata only. Pause or cancel at any time." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Margin="0,0,24,0"><TextBlock Text="2  Explore" Style="{StaticResource BodyStrongText}"/><TextBlock Text="Space map by type or age, largest files and folders." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
     <StackPanel><TextBlock Text="3  Review" Style="{StaticResource BodyStrongText}"/><TextBlock Text="Verified duplicates and reversible quarantine." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
    </UniformGrid>
   </StackPanel>
  </ScrollViewer>

  <!-- Normal layout -->
  <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding HasHistory, Converter={StaticResource Visible}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

   <DockPanel Margin="0,0,0,16">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Session.CanInteract}">
     <TextBlock Text="Profile" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox Width="220" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Scan profile"/>
    </StackPanel>
    <TextBlock Text="Scan" Style="{StaticResource TitleText}"/>
   </DockPanel>

   <!-- Scan in progress -->
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16" Visibility="{Binding Session.Scanning, Converter={StaticResource Visible}}">
    <StackPanel>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Command="{Binding Session.PauseCommand}" Margin="0,0,8,0" MinWidth="96">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="0,0,8,0"/><TextBlock Text="{Binding Session.PauseLabel}"/></StackPanel>
       </Button>
       <Button Command="{Binding Session.CancelCommand}" MinWidth="96" ToolTip="Esc">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0"/><TextBlock Text="Cancel"/></StackPanel>
       </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0"/>
       <TextBlock Style="{StaticResource BodyStrongText}" FontSize="16"><Run Text="Scanning "/><Run Text="{Binding ScanTarget, Mode=OneWay}"/></TextBlock>
       <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Visibility="{Binding ScanEngine, Converter={StaticResource VisibleIfText}}"><TextBlock Text="{Binding ScanEngine}" Style="{StaticResource BadgeText}"/></Border>
       <Border Style="{StaticResource Badge}" Margin="6,0,0,0"><TextBlock Text="{Binding ScanWorker}" Style="{StaticResource BadgeText}"/></Border>
      </StackPanel>
     </DockPanel>
     <ProgressBar Margin="0,14,0,12" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressKnown, Converter={StaticResource Negate}}" AutomationProperties.Name="Scan progress"/>
     <WrapPanel>
      <TextBlock Margin="0,0,28,0" Visibility="{Binding ProgressText, Converter={StaticResource VisibleIfText}}"><Run Text="{Binding ProgressText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/></TextBlock>
      <TextBlock Margin="0,0,28,0" Typography.NumeralAlignment="Tabular"><Run Text="Files " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding ScanFiles, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold"/></TextBlock>
      <TextBlock Margin="0,0,28,0" Typography.NumeralAlignment="Tabular"><Run Text="Logical " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding ScanBytes, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
      <TextBlock Margin="0,0,28,0" Typography.NumeralAlignment="Tabular"><Run Text="Elapsed " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run Text="{Binding ScanElapsed, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
     </WrapPanel>
     <TextBlock Text="Labelled Partial until the scan completes. Pause waits for the current batch." Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>

   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Drives and roots" Style="{StaticResource BodyStrongText}" FontSize="16"/>
      <TextBlock Text="Overlapping roots are merged. Hidden and system files are included." Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False" IsEnabled="{Binding Session.CanInteract}">
      <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource DriveCard}" Focusable="False" AutomationProperties.Name="Drives">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </ScrollViewer>
     <Button Grid.Row="2" Command="{Binding AddRootCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/><TextBlock Text="Add folder or share"/></StackPanel>
     </Button>
     <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
       <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}"><TextBlock Text="Recent snapshots" Style="{StaticResource BodyStrongText}"/></Border>
       <DataGrid x:Name="SnapshotsGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Session.History}" SelectionMode="Single" MouseDoubleClick="Snapshots_DoubleClick" KeyDown="Snapshots_KeyDown" AutomationProperties.Name="Recent snapshots. Press Enter to open.">
        <DataGrid.Columns>
         <DataGridTextColumn Header="#" Binding="{Binding Value.Id}" Width="50"/>
         <DataGridTextColumn Header="Roots" Binding="{Binding RootsText}" Width="*"/>
         <DataGridTemplateColumn Header="State" Width="130">
          <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StateBadge}" Tag="{Binding Value.State}"><TextBlock Style="{StaticResource StateBadgeText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="Scanned" Binding="{Binding StartedText}" Width="150"/>
         <DataGridTextColumn Header="Files" Binding="{Binding Value.Files, StringFormat=N0}" Width="100"/>
         <DataGridTextColumn Header="Logical" Binding="{Binding LogicalText}" Width="100"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Border>
    </Grid>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" IsEnabled="{Binding Session.CanInteract}">
     <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,14">
       <StackPanel>
        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ScanCommand}" Content="{Binding ScanButtonText}" HorizontalAlignment="Stretch" MinHeight="40" FontSize="15" ToolTip="F5"/>
        <TextBlock Text="Scanning reads metadata only. Nothing is changed." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
       <StackPanel Margin="18,16">
        <TextBlock Text="Options" Style="{StaticResource BodyStrongText}" FontSize="16" Margin="0,0,0,8"/>
        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Session.Administrator}">
         <StackPanel><TextBlock Text="Administrator scan"/><TextBlock Text="Runs a read-only worker through UAC" Style="{StaticResource CaptionText}"/></StackPanel>
        </CheckBox>
        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PreferMft}">
         <StackPanel><TextBlock Text="Prefer raw MFT"/><TextBlock Text="Whole local NTFS volumes. Falls back to directory scan with a diagnostic." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
        </CheckBox>
        <TextBlock Text="Extra roots, one per line" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <TextBox Text="{Binding ExtraRoots}" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Extra scan roots" LostFocus="ExtraRoots_LostFocus"/>
        <TextBlock Text="Exclusions, one per line" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <TextBox Text="{Binding Exclusions}" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Scan exclusions"/>
        <TextBlock Text="Absolute folder prefix or filename wildcard." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        <TextBlock Text="Save as profile" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"/>
         <TextBox Text="{Binding ProfileName}" AutomationProperties.Name="Profile name"/>
        </DockPanel>
        <Border Style="{StaticResource Callout}" Margin="0,16,0,0">
         <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
          <TextBlock Text="Cloud placeholders and reparse points are listed but never opened or hydrated." Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxWidth="250"/>
         </StackPanel>
        </Border>
        <Button Style="{StaticResource SubtleButton}" Command="{Binding ElevateCommand}" HorizontalAlignment="Left" Margin="-11,12,0,0">
         <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,8,0"/><TextBlock Text="Restart FileViz as administrator"/></StackPanel>
        </Button>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
