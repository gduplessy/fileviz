<UserControl x:Class="FileViz.App.Views.Sections.ExplorerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FileViz.App.Views">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition/></Grid.RowDefinitions>

  <!-- Header: location, snapshot, actions -->
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <ComboBox Width="300" ItemsSource="{Binding Session.History}" DisplayMemberPath="Label" SelectedItem="{Binding Session.SelectedSnapshot}" IsEnabled="{Binding Session.CanInteract}" AutomationProperties.Name="Selected snapshot" Margin="0,0,8,0"/>
    <ComboBox Width="180" ItemsSource="{Binding Session.SnapshotRoots}" SelectedItem="{Binding Session.CurrentRoot}" IsEnabled="{Binding Session.CanInteract}" AutomationProperties.Name="Root in snapshot" Margin="0,0,8,0"/>
    <Button Command="{Binding ExportCommand}" Margin="0,0,8,0" ToolTip="Ctrl+E">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0"/><TextBlock Text="Export"/></StackPanel>
    </Button>
    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding DataContext.Home.RescanCommand, RelativeSource={RelativeSource AncestorType=Window}}">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Rescan"/></StackPanel>
    </Button>
   </StackPanel>
   <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
    <TextBlock Text="{Binding BrowseLabel}" Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding BrowseCaption}" Style="{StaticResource CaptionText}"/>
   </StackPanel>
  </DockPanel>

  <!-- Summary -->
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,12">
   <StackPanel>
    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource BodyStrongText}" FontSize="16" Typography.NumeralAlignment="Tabular"/>
    <TextBlock Text="{Binding CoverageText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
   </StackPanel>
  </Border>

  <!-- Space map toolbar -->
  <DockPanel Grid.Row="2" Margin="0,0,0,8">
   <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Largest files" Command="{Binding LargestCommand}"/>
   <StackPanel Orientation="Horizontal">
    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Command="{Binding UpCommand}" AutomationProperties.Name="Up one level" ToolTip="Up one level (Alt+Up)" Margin="0,0,8,0"/>
    <TextBlock Text="Space map" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"/>
    <TextBlock Text="Click a folder to open it." Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="3" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
   <views:Treemap Items="{Binding MapItems}" FolderChosen="Treemap_FolderChosen" AutomationProperties.Name="Space map"/>
  </Border>

  <!-- Lists -->
  <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
   <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Padding="12,8">
     <WrapPanel>
      <Border Style="{StaticResource SegmentTrack}" Margin="0,0,12,4">
       <StackPanel Orientation="Horizontal">
        <RadioButton Style="{StaticResource Segment}" GroupName="ExplorerList" Content="Files" IsChecked="{Binding ShowFiles}"/>
        <RadioButton Style="{StaticResource Segment}" GroupName="ExplorerList" Content="Folders" IsChecked="{Binding ShowFolders}"/>
        <RadioButton Style="{StaticResource Segment}" GroupName="ExplorerList" Content="Types" IsChecked="{Binding ShowTypes}"/>
       </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFiles, Converter={StaticResource Visible}}" Margin="0,0,0,4">
       <TextBox Width="190" Text="{Binding Search}" AutomationProperties.Name="Filter by name or path" ToolTip="Name or path" Margin="0,0,8,0"/>
       <TextBox Width="70" Text="{Binding Extension}" AutomationProperties.Name="Extension filter" ToolTip="Extension, for example .mkv" Margin="0,0,8,0"/>
       <TextBox Width="70" Text="{Binding MinimumMiB}" AutomationProperties.Name="Minimum size in MiB" ToolTip="Minimum size in MiB" Margin="0,0,8,0"/>
       <DatePicker Width="140" SelectedDate="{Binding ModifiedAfter}" AutomationProperties.Name="Modified on or after" ToolTip="Modified on or after" Margin="0,0,12,0"/>
       <CheckBox Content="Allocated size" IsChecked="{Binding Allocated}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <CheckBox Content="Hidden only" IsChecked="{Binding HiddenOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <Button Content="Filter" Command="{Binding FilterCommand}" IsDefault="False"/>
      </StackPanel>
     </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="{Binding ShowFiles, Converter={StaticResource Visible}}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Style="{StaticResource SubtleButton}" Click="Explorer_Click" ToolTip="Show the selected file in File Explorer"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0"/><TextBlock Text="Explorer"/></StackPanel></Button>
       <Button Style="{StaticResource SubtleButton}" Click="Copy_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Copy path"/></StackPanel></Button>
       <Button Style="{StaticResource SubtleButton}" Click="Properties_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0"/><TextBlock Text="Properties"/></StackPanel></Button>
       <Button Click="CleanupFiles_Click" Margin="8,0,0,0" IsEnabled="{Binding Session.CanInteract}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Margin="0,0,8,0"/><TextBlock Text="Review for cleanup…"/></StackPanel></Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous page"/>
       <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" AutomationProperties.Name="Next page"/>
       <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid>
     <DataGrid x:Name="FilesGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Files}" MouseDoubleClick="Files_DoubleClick" AutomationProperties.Name="Largest files" Visibility="{Binding ShowFiles, Converter={StaticResource Visible}}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
       <DataGridCheckBoxColumn Header="Folder" Binding="{Binding IsDirectory}" Width="72"/>
       <DataGridTextColumn Header="Logical" Binding="{Binding SizeText}" Width="90"/>
       <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedText}" Width="90"/>
       <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="140"/>
       <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <DataGrid Style="{StaticResource ListGrid}" ItemsSource="{Binding Folders}" MouseDoubleClick="Folders_DoubleClick" AutomationProperties.Name="Largest folders" Visibility="{Binding ShowFolders, Converter={StaticResource Visible}}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Folder" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes, StringFormat=N0}" Width="160"/>
       <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <DataGrid Style="{StaticResource ListGrid}" ItemsSource="{Binding ExtensionsBreakdown}" AutomationProperties.Name="File types" Visibility="{Binding ShowTypes, Converter={StaticResource Visible}}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Extension" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Logical bytes" Binding="{Binding Bytes, StringFormat=N0}" Width="160"/>
       <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
