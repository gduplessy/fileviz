<UserControl x:Class="FileViz.App.Views.Sections.PhotosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Button DockPanel.Dock="Right" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" Content="Analyze photos" AutomationProperties.Name="Analyze photo dimensions"/>
   <TextBlock Text="Photos" Style="{StaticResource TitleText}"/>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,12">
   <StackPanel>
    <WrapPanel IsEnabled="{Binding Session.CanInteract}">
     <StackPanel Margin="0,0,16,8"><TextBlock Text="Drive or folder" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/><ComboBox Width="300" ItemsSource="{Binding AvailableScopes}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Label" AutomationProperties.Name="Drive or folder for photo analysis"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Text="Minimum short edge (px)" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/><TextBox Width="140" Text="{Binding MinimumShortEdge, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minimum photo short edge in pixels"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Text="Minimum megapixels" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/><TextBox Width="130" Text="{Binding MinimumMegapixels, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minimum photo megapixels"/></StackPanel>
     <StackPanel Margin="0,0,16,8"><TextBlock Text="Name or path" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/><TextBox Width="180" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter photo name or path"/></StackPanel>
     <Button Content="Apply filters" Command="{Binding FilterCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding ScopeDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
    <TextBlock Text="Matches images below either enabled threshold. The short edge ignores portrait/landscape orientation; zero disables a threshold. Resolution does not measure blur or compression quality." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,12" Visibility="{Binding HasActivity, Converter={StaticResource Visible}}">
   <StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Command="{Binding Session.CancelCommand}" Content="Cancel" AutomationProperties.Name="Cancel photo analysis" Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}"/><TextBlock Text="{Binding ActivityPhase}" Style="{StaticResource BodyStrongText}" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="4" Margin="0,8,0,8" Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}"/>
    <TextBlock Text="{Binding ActivityText}" Style="{StaticResource CaptionText}"/>
    <TextBlock Text="{Binding ActivityPath}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityPath}" Visibility="{Binding ActivityPath, Converter={StaticResource VisibleIfText}}"/>
    <TextBlock Text="{Binding ActivityHeartbeat}" Style="{StaticResource CaptionText}" Visibility="{Binding ActivityHeartbeat, Converter={StaticResource VisibleIfText}}"/>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding Summary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Padding="12,8">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SubtleButton}"/><Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource SubtleButton}"/></StackPanel>
       <StackPanel><TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}"/><CheckBox Content="Show unreadable / unsupported images" IsChecked="{Binding ErrorsOnly}" IsEnabled="{Binding Session.CanInteract}" Margin="0,4,0,0" AutomationProperties.Name="Show photo analysis errors"/></StackPanel>
      </DockPanel>
     </Border>
     <DataGrid ItemsSource="{Binding Photos}" SelectedItem="{Binding Selected}" Style="{StaticResource ListGrid}" SelectionMode="Single" IsEnabled="{Binding Session.CanInteract}" AutomationProperties.Name="Low resolution photo results">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Remove" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Remove, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRemove}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Path}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Photo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="185"/>
       <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" IsEnabled="{Binding Session.CanInteract}">
      <Button Content="Review removals…" Click="Review_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Review selected photo removals"/>
      <TextBlock Text="Quarantine is reversible in Cleanup; space is retained until disposal." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
       <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}"/>
       <TextBlock Text="{Binding SelectedDetails}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
       <UniformGrid Columns="2" Margin="0,0,0,8"><Button Content="Load preview" Command="{Binding PreviewCommand}" Margin="0,0,4,0"/><Button Content="Explorer" Click="Show_Click" Margin="4,0,0,0" ToolTip="{Binding SelectedPath}"/></UniformGrid>
       <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Height="140"><Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="Selected photo preview"/></Border>
       <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,8"/>
       <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,12"/>
       <TextBlock Text="{Binding SelectionText}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SelectionNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
       <WrapPanel><Button Content="Select this page" Command="{Binding SelectPageCommand}" Margin="0,0,8,8"/><Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
