<UserControl x:Class="FileViz.App.Views.Sections.DuplicatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Session.CanInteract}">
    <TextBlock Text="Hash" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Width="120" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" AutomationProperties.Name="Hash algorithm" Margin="0,0,8,0"/>
    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding DuplicateCommand}">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Find duplicates"/></StackPanel>
    </Button>
   </StackPanel>
   <TextBlock Text="Duplicates" Style="{StaticResource TitleText}"/>
  </DockPanel>

  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding Session.CanInteract}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <StackPanel>
     <CheckBox Content="Compare across the roots selected below" IsChecked="{Binding CrossDrive}"/>
     <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="28,4,0,0" Focusable="False">
      <ItemsControl ItemsSource="{Binding DuplicateRoots}" IsEnabled="{Binding CrossDrive}" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}"><TextBlock Text="{Binding Root}" Style="{StaticResource MonoText}"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <TextBlock Text="{Binding DuplicateText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="Preferred keeper folder" Style="{StaticResource FieldLabel}"/>
     <TextBox Text="{Binding PreferredFolder}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Preferred keeper folder"/>
     <TextBlock Text="Guides suggested keepers. Suggestions never select removals." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,8">
     <DockPanel>
      <Button DockPanel.Dock="Right" Click="CleanupDuplicates_Click" IsEnabled="{Binding Session.CanInteract}">
       <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Margin="0,0,8,0"/><TextBlock Text="Review selected removals…"/></StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal">
       <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous groups"/>
       <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" AutomationProperties.Name="Next groups"/>
       <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
       <TextBlock Text="Select the copies to remove. Every group must keep at least one copy." Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <DataGrid x:Name="DuplicatesGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Duplicates}" AutomationProperties.Name="Duplicate groups">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Group" Binding="{Binding GroupId}" Width="70"/>
      <DataGridCheckBoxColumn Header="Suggested keeper" Binding="{Binding SuggestedKeeper}" Width="150"/>
      <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="150"/>
      <DataGridTextColumn Header="Size" Binding="{Binding Entry.SizeText}" Width="90"/>
      <DataGridTextColumn Header="Path" Binding="{Binding Entry.Path}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
