<UserControl x:Class="FileViz.App.Views.Sections.DuplicatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="Stage" TargetType="Border"><Setter Property="Padding" Value="20,12"/><Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="0,0,1,0"/></Style>
  <Style x:Key="StageValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="22"/></Style>
 </UserControl.Resources>
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Session.CanInteract}">
    <TextBlock Text="Hash" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Border Style="{StaticResource SegmentTrack}" Margin="0,0,8,0">
     <StackPanel Orientation="Horizontal">
      <RadioButton Style="{StaticResource Segment}" GroupName="Hash" Content="SHA-256" IsChecked="{Binding UseSha256}"/>
      <RadioButton Style="{StaticResource Segment}" GroupName="Hash" Content="SHA-1" IsChecked="{Binding UseSha1}" ToolTip="Compatibility only"/>
      <RadioButton Style="{StaticResource Segment}" GroupName="Hash" Content="MD5" IsChecked="{Binding UseMd5}" ToolTip="Compatibility only"/>
     </StackPanel>
    </Border>
    <Button Style="{StaticResource SubtleButton}" Content="Find name matches" Command="{Binding NameCommand}" Margin="0,0,8,0" ToolTip="Fast, but names never prove two files are the same"/>
    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding DuplicateCommand}">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="{Binding AnalyzeLabel}"/></StackPanel>
    </Button>
   </StackPanel>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="Duplicates" Style="{StaticResource TitleText}"/>
    <Border Style="{StaticResource Badge}" Margin="16,6,16,0" Padding="10,3" ToolTip="{Binding ScopeText}"><TextBlock Style="{StaticResource CaptionText}" MaxWidth="300" TextTrimming="CharacterEllipsis"><Run Text="Scope "/><Run Text="{Binding ScopeText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/></TextBlock></Border>
   </StackPanel>
  </DockPanel>

  <!-- Pipeline -->
  <StackPanel Grid.Row="1">
   <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12" Visibility="{Binding HasActivity, Converter={StaticResource Visible}}" AutomationProperties.Name="Duplicate analysis activity">
    <StackPanel>
     <DockPanel>
      <Button DockPanel.Dock="Right" Command="{Binding Session.CancelCommand}" Content="Cancel analysis" Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" AutomationProperties.Name="Cancel duplicate analysis"/>
      <TextBlock Text="{Binding AnalysisHeading}" Style="{StaticResource BodyStrongText}" FontSize="16"/>
     </DockPanel>
     <TextBlock Text="{Binding ActivityPhase}" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar Minimum="0" Maximum="100" Value="{Binding ActivityPercent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,12" Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" AutomationProperties.Name="Progress within the current duplicate analysis stage"/>
     <TextBlock Text="{Binding ActivityCounts}" Style="{StaticResource CaptionText}" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ActivityFile}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityFile}" Margin="0,4,0,0" Visibility="{Binding ActivityFile, Converter={StaticResource VisibleIfText}}"/>
     <TextBlock Text="{Binding FileProgressText}" Style="{StaticResource CaptionText}" Visibility="{Binding FileProgressText, Converter={StaticResource VisibleIfText}}"/>
     <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding ActivityElapsed}" Style="{StaticResource CaptionText}" Margin="0,0,20,0"/><TextBlock Text="{Binding ActivityHeartbeat}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></WrapPanel>
    </StackPanel>
   </Border>
  <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
   <Grid>
    <TextBlock Text="No analysis yet. Analyze content compares sizes, then samples, then full hashes; only full-hash matches count as duplicates." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="20,16" Visibility="{Binding NoRun, Converter={StaticResource Visible}}"/>
    <Grid Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Stage}"><StackPanel><TextBlock Text="1  Same size" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Run.SizeCandidates, StringFormat=N0}" Style="{StaticResource StageValue}"/><TextBlock Text="files with a size twin" Style="{StaticResource CaptionText}"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Stage}"><StackPanel><TextBlock Text="2  Sample match" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Run.SampleMatches, StringFormat=N0}" Style="{StaticResource StageValue}"/><TextBlock Text="matching sampled blocks" Style="{StaticResource CaptionText}"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Stage}"><StackPanel><TextBlock Text="3  Full hash verified" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Run.VerifiedFiles, StringFormat=N0}" Style="{StaticResource StageValue}"/><TextBlock Text="{Binding VerifiedNote}" Style="{StaticResource CaptionText}"/></StackPanel></Border>
     <Border Grid.Column="3" Style="{StaticResource Stage}"><StackPanel><TextBlock Text="Reclaimable" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Run.Reclaimable, Converter={StaticResource Bytes}}" Style="{StaticResource StageValue}" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/><TextBlock Text="verified groups only" Style="{StaticResource CaptionText}"/></StackPanel></Border>
     <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="0,8,8,0" Padding="20,12">
      <StackPanel VerticalAlignment="Center">
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Run.NameMatches, StringFormat=N0}" Style="{StaticResource BodyStrongText}" FontSize="12"/><TextBlock Text="Name matches" Style="{StaticResource CaptionText}"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Run.Aliases, StringFormat=N0}" Style="{StaticResource BodyStrongText}" FontSize="12"/><TextBlock Text="Hard-link aliases collapsed" Style="{StaticResource CaptionText}"/></DockPanel>
       <TextBlock Text="Name matches never count toward savings." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>
  </StackPanel>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous groups"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" AutomationProperties.Name="Next groups"/>
     </StackPanel>
     <TextBlock Text="Choose the copy to keep and the copies to remove." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
     <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.Name="Duplicate groups">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
         <StackPanel>
          <Border Style="{StaticResource CardHeader}">
           <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Savings}" Style="{StaticResource BodyStrongText}" Width="110" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
            <Border x:Name="Evidence" DockPanel.Dock="Right" Style="{StaticResource Badge}" BorderThickness="0" Margin="12,0"><TextBlock x:Name="EvidenceText" Text="{Binding EvidenceLabel}" Style="{StaticResource BadgeText}"/></Border>
            <StackPanel Orientation="Horizontal">
             <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}" Margin="0,0,10,0" VerticalAlignment="Center"/>
             <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
           </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border x:Name="Row" Padding="16,6" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <DockPanel>
               <RadioButton DockPanel.Dock="Left" GroupName="{Binding GroupKey}" IsChecked="{Binding Keep}" Content="Keep" Margin="0,0,16,0" MinWidth="80" AutomationProperties.Name="Keep this copy"/>
               <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Remove}" IsEnabled="{Binding CanRemove}" Content="Remove" Margin="0,0,16,0" MinWidth="96" AutomationProperties.Name="Select this copy for removal"/>
               <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" BorderThickness="0" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" Margin="12,0,0,0"><TextBlock Text="{Binding Note}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Border>
               <TextBlock DockPanel.Dock="Right" Text="{Binding Entry.ModifiedText}" Style="{StaticResource CaptionText}" Width="140" VerticalAlignment="Center" Margin="12,0,0,0"/>
               <TextBlock Text="{Binding Entry.Path}" Style="{StaticResource MonoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Path}"/>
              </DockPanel>
             </Border>
             <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Remove}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/></DataTrigger>
             </DataTemplate.Triggers>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Border>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding IsVerified}" Value="True"><Setter TargetName="Evidence" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/><Setter TargetName="EvidenceText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>

   <!-- Review tray -->
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,14">
      <StackPanel>
       <TextBlock Text="Files move to quarantine on the same volume. Disk space is held until you dispose of them." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
       <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding ReviewLabel}" IsEnabled="{Binding HasSelection}" HorizontalAlignment="Stretch" MinHeight="40" FontSize="15" Click="Review_Click"/>
      </StackPanel>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="18,16" IsEnabled="{Binding Session.CanInteract}">
       <TextBlock Text="Selected for removal" Style="{StaticResource BodyStrongText}" FontSize="16"/>
       <TextBlock Text="{Binding SelectedBytes}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="Select all non-keepers" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/>
        <Button Style="{StaticResource SubtleButton}" Content="Clear" Command="{Binding ClearCommand}"/>
       </StackPanel>
       <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="-18,16"/>
       <TextBlock Text="Preferred keeper folder" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding PreferredFolder}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Preferred keeper folder"/>
       <TextBlock Text="Guides suggested keepers on the next analysis. Suggestions never select removals." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <CheckBox Content="Compare across selected roots" IsChecked="{Binding CrossDrive}" Margin="0,16,0,4"/>
       <ItemsControl ItemsSource="{Binding DuplicateRoots}" IsEnabled="{Binding CrossDrive}" Focusable="False" Margin="24,0,0,0">
        <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}"><TextBlock Text="{Binding Root}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
