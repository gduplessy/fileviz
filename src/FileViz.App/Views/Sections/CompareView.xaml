<UserControl x:Class="FileViz.App.Views.Sections.CompareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="Compare" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding Session.CanInteract}">
   <TextBlock Text="Before" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox Width="340" ItemsSource="{Binding Session.History}" DisplayMemberPath="Label" SelectedItem="{Binding CompareBefore}" AutomationProperties.Name="Snapshot to compare against"/>
   <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" Margin="12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   <TextBlock Text="After" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox Width="340" ItemsSource="{Binding Session.History}" DisplayMemberPath="Label" SelectedItem="{Binding Session.SelectedSnapshot}" AutomationProperties.Name="Current snapshot"/>
   <Button Style="{StaticResource AccentButtonStyle}" Content="Compare" Command="{Binding CompareCommand}" Margin="12,0,0,0" MinWidth="100"/>
  </StackPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
     <TextBlock Text="First 250 added, removed, or grown files, largest first. Partial snapshots can show false additions or removals." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
    </Border>
    <DataGrid Style="{StaticResource ListGrid}" ItemsSource="{Binding Differences}" AutomationProperties.Name="Changed files">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="100"/>
      <DataGridTextColumn Header="Before bytes" Binding="{Binding Before, StringFormat=N0}" Width="130"/>
      <DataGridTextColumn Header="After bytes" Binding="{Binding After, StringFormat=N0}" Width="130"/>
      <DataGridTextColumn Header="Change bytes" Binding="{Binding Delta, StringFormat=N0}" Width="130"/>
      <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
