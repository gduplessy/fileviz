<UserControl x:Class="FileViz.App.Views.Sections.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="64"/><Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
  <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000" HorizontalAlignment="Left">
   <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>

   <TextBlock Text="Appearance" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24">
    <StackPanel>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0">
      <DockPanel>
       <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="App theme"/>
       <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE790;" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="App theme"/><TextBlock Text="Follows Windows light or dark mode by default" Style="{StaticResource CaptionText}"/></StackPanel>
      </DockPanel>
     </Border>
     <Border Style="{StaticResource SettingRow}">
      <DockPanel>
       <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding ColorSettingsCommand}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="Windows color settings"/><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8A7;" Margin="8,0,0,0"/></StackPanel>
       </Button>
       <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE771;" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Accent color"/><TextBlock Text="FileViz uses your Windows accent color" Style="{StaticResource CaptionText}"/></StackPanel>
      </DockPanel>
     </Border>
    </StackPanel>
   </Border>

   <TextBlock Text="Storage and privacy" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24">
    <StackPanel>
     <Border Style="{StaticResource SettingRow}" BorderThickness="0">
      <DockPanel>
       <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE8B7;" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Index database"/><TextBlock Text="{Binding IndexPath}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
      </DockPanel>
     </Border>
     <Border Style="{StaticResource SettingRow}">
      <DockPanel>
       <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE72E;" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Local only"/><TextBlock Text="No telemetry, automatic deletion, automatic updates, drivers, or remote storage." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
      </DockPanel>
     </Border>
    </StackPanel>
   </Border>

   <TextBlock Text="About" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
   <Border Style="{StaticResource Card}" Padding="0">
    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
     <DockPanel>
      <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE946;" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock><Run Text="FileViz "/><Run Text="{Binding Version, Mode=OneTime}"/><Run Text=" Preview"/></TextBlock>
       <TextBlock Text="GPL-3.0-only · Third-party notices ship with the app" Style="{StaticResource CaptionText}"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
