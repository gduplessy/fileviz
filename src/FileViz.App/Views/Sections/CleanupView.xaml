<UserControl x:Class="FileViz.App.Views.Sections.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Session.CanInteract}">
    <Button Click="Restore_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,8,0"/><TextBlock Text="Restore selected"/></StackPanel></Button>
    <Button Click="Recycle_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0"/><TextBlock Text="Send to Recycle Bin…"/></StackPanel></Button>
   </StackPanel>
   <TextBlock Text="Cleanup" Style="{StaticResource TitleText}"/>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource CautionCallout}" Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal">
    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
    <TextBlock Text="Quarantined files still use disk space. Restore never overwrites an existing file. Emptying the Recycle Bin is a separate Windows action." Style="{StaticResource BodyText}"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
   <DataGrid x:Name="CleanupGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding CleanupHistory}" SelectionMode="Single" AutomationProperties.Name="Cleanup journal">
    <DataGrid.Columns>
     <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140"/>
     <DataGridTextColumn Header="Original path" Binding="{Binding Original}" Width="*"/>
     <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170"/>
     <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="260"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </Grid>
</UserControl>
