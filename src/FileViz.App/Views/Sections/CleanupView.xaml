<UserControl x:Class="FileViz.App.Views.Sections.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="{StaticResource PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="Cleanup" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,12">
   <DockPanel>
    <Border DockPanel.Dock="Right" Style="{StaticResource CautionCallout}" MaxWidth="460" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
      <TextBlock Text="Quarantined files still use disk space. Restore them, or send them to the Recycle Bin when you are sure. Emptying the bin is a separate Windows action." Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxWidth="400"/>
     </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal">
     <StackPanel Margin="0,0,28,0"><TextBlock Text="Held in quarantine" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding HeldText}" Style="{StaticResource MetricValue}" FontFamily="{StaticResource DisplayFont}" FontSize="22"/></StackPanel>
     <Rectangle Width="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,28,0"/>
     <StackPanel Margin="0,0,28,0"><TextBlock Text="Restored" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding RestoredCount}" Style="{StaticResource MetricValue}"/></StackPanel>
     <StackPanel Margin="0,0,28,0"><TextBlock Text="Recycle Bin requested" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DisposedCount}" Style="{StaticResource MetricValue}"/></StackPanel>
     <StackPanel><TextBlock Text="Failed or needs review" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ProblemCount}" Style="{StaticResource MetricValue}"/></StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Padding="12,8">
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center"><Run Text="Journal in "/><Run Text="%LOCALAPPDATA%\FileViz" FontFamily="{StaticResource MonoFont}"/></TextBlock>
       <Border Style="{StaticResource SegmentTrack}">
        <StackPanel Orientation="Horizontal">
         <RadioButton Style="{StaticResource Segment}" GroupName="CleanupFilter" Content="{Binding HeldFilterLabel}" IsChecked="{Binding ShowHeld}"/>
         <RadioButton Style="{StaticResource Segment}" GroupName="CleanupFilter" Content="{Binding AllFilterLabel}" IsChecked="{Binding ShowAll}"/>
        </StackPanel>
       </Border>
      </DockPanel>
     </Border>
     <DataGrid Style="{StaticResource ListGrid}" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="Cleanup journal">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="State" Width="190">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Border x:Name="Pill" Style="{StaticResource Badge}" BorderThickness="0"><TextBlock x:Name="Label" Text="{Binding State}" Style="{StaticResource BadgeText}"/></Border>
         <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Quarantined"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/><Setter TargetName="Label" Property="Text" Value="Held"/></DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Restored"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Needs review"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Windows disposal completed"><Setter TargetName="Label" Property="Text" Value="Recycle Bin requested"/></DataTrigger>
         </DataTemplate.Triggers>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Original path" Width="*">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Margin="0,4">
          <TextBlock Text="{Binding Original}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Original}"/>
          <TextBlock Text="{Binding Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource VisibleIfText}}"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid>
     <TextBlock Text="Select an entry to see its journal and restore it." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="18" Visibility="{Binding HasSelection, Converter={StaticResource Hidden}}"/>
     <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,14" IsEnabled="{Binding Session.CanInteract}">
       <StackPanel>
        <UniformGrid Columns="2" Margin="0,0,0,8">
         <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,4,0" Click="Restore_Click" IsEnabled="{Binding SelectedIsHeld}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,8,0"/><TextBlock Text="Restore"/></StackPanel></Button>
         <Button Margin="4,0,0,0" Click="Show_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0"/><TextBlock Text="Show in Explorer"/></StackPanel></Button>
        </UniformGrid>
        <Button HorizontalAlignment="Stretch" Click="Recycle_Click" IsEnabled="{Binding SelectedIsHeld}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0"/><TextBlock Text="Send to Recycle Bin…"/></StackPanel></Button>
        <TextBlock Text="Restore never overwrites a file that now exists at the original path." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
       <StackPanel Margin="18,16" DataContext="{Binding}">
        <TextBlock Text="{Binding SelectedName}" Style="{StaticResource BodyStrongText}" FontSize="16" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,14"><Run Text="{Binding Selected.State, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTime, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="Original location" Style="{StaticResource CaptionText}"/>
        <TextBlock Text="{Binding Selected.Original}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,2,0,10"/>
        <TextBlock Text="Held at" Style="{StaticResource CaptionText}"/>
        <TextBlock Text="{Binding Selected.Destination}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10"/>
        <TextBlock Text="File ID" Style="{StaticResource CaptionText}"/>
        <TextBlock Text="{Binding Selected.Identity}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10"/>
        <Border Style="{StaticResource Callout}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding Selected.Error, Converter={StaticResource VisibleIfText}}">
         <TextBlock Text="{Binding Selected.Error}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
